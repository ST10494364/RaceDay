@model List<RaceDay.Web.Models.EventDto>
@{
    ViewData["Title"] = "Manage events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Manage events</h2>
    <a class="btn btn-primary" asp-action="Create">Create event</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead>
                <tr><th>Event</th><th>Date</th><th>Location</th><th>Distance</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.Name <div class="small text-muted">@e.EventTypeName</div></td>
                        <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@e.Location</td>
                        <td>@e.DistanceKm km</td>
                        <td><span class="status-badge @(e.Status == "Open" ? "status-open" : "status-closed")">@e.Status</span></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@e.EventId">Edit</a>
                            <a class="btn btn-outline-primary btn-sm" asp-action="Categories" asp-route-id="@e.EventId">Categories</a>
                            <a class="btn btn-outline-primary btn-sm" asp-action="Enrolments" asp-route-id="@e.EventId">Enrolments</a>
                            <a class="btn btn-outline-primary btn-sm" asp-action="Results" asp-route-id="@e.EventId">Results</a>
                            <form asp-action="Delete" asp-route-id="@e.EventId" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-muted">You have not created any events yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>